# AI Hub — environment variables
#
# All keys are OPTIONAL. The app works as long as at least one provider has a
# key, either via this file or pasted into the in-app Settings dashboard
# (which stores keys in browser localStorage only — never on the server).
#
# Native DashScope features (image gen, video gen, TTS, ASR) require
# DASHSCOPE_API_KEY specifically. Other providers cover chat / vision.

# Alibaba Cloud Model Studio (Qwen, Wan video, TTS, ASR)
# Get key: https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY=

# NVIDIA NIM — free tier with Llama 3.3, DeepSeek R1, Vision models
# Get key: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# OpenAI (GPT-4o, o1)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (fastest Llama hosting)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek (cheapest)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter (aggregator — one key, access to many models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
